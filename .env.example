DATABASE_URL=postgres://postgres:postgres@localhost:5432/enterprisecrm
PORT=4000
# Demo cadence: collectors poll every POLL_MS and ship one aggregated batch per AGG_WINDOW_SEC (production: 15-60s polls, 60s windows)
POLL_MS=3000
AGG_WINDOW_SEC=15
HEARTBEAT_SEC=15
SLA_TICK_MS=5000
SYSLOG_PORT=5514
# --- auth / production (see README) ---
SESSION_SECRET=generate-a-random-string-of-32+-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
API_KEY=random-key-for-collectors-and-email-gateway
SEED_DEMO=true
DEMO_PASSWORD=demo1234
ENABLE_SIM=true
PGSSL=false
